diff --git a/tools/aix/ansi_render.pl b/tools/aix/ansi_render.pl
new file mode 100755
index 0000000..bee9cf8
--- /dev/null
+++ b/tools/aix/ansi_render.pl
@@ -0,0 +1,98 @@
+#!/usr/bin/perl
+# ansi_render.pl -- Projekt btop-aix (2026-10-12)
+# Zweck: Rendert einen mitgeschnittenen Terminal-Ausgabestrom (btop-Bildschirm mit
+#        ANSI-Cursorpositionierung) in ein ebenes Textbild, damit sich der letzte
+#        Bildschirminhalt eines nicht-interaktiven Laufs pruefen laesst.
+#        Verstanden werden CSI H/f (Cursor setzen), A/B/C/D (bewegen), J/K (loeschen),
+#        s/u und ESC 7/8 (Cursor sichern), SGR und private Modi werden ignoriert,
+#        Breite Zeichen (UTF-8) belegen eine Zelle (Naeherung).
+# Aufruf: perl tools/aix/ansi_render.pl --rows 50 --cols 160 <datei> > bild.txt
+# Letzter bekannter guter Aufruf:
+#   perl tools/aix/ansi_render.pl --rows 50 --cols 160 --keep-last-frame tools/aix/analysis/<lauf>_screen.raw
+use strict;
+use warnings;
+use utf8;
+use Getopt::Long;
+binmode STDOUT, ':encoding(UTF-8)';
+
+my ($rows, $cols, $keep_last) = (50, 160, 0);
+GetOptions('rows=i' => \$rows, 'cols=i' => \$cols, 'keep-last-frame' => \$keep_last)
+    or die "Aufruf: $0 [--rows N] [--cols N] [--keep-last-frame] DATEI\n";
+my $file = shift or die "Datei fehlt\n";
+open my $fh, '<:raw', $file or die "$file: $!";
+local $/; my $data = <$fh>; close $fh;
+utf8::decode($data);
+
+# --keep-last-frame: btop loescht beim Beenden den Bildschirm (ESC [2J); fuer die
+# Pruefung des letzten Bildes wird der Strom vor dem letzten Loeschen abgeschnitten.
+if ($keep_last) {
+    my $pos = rindex($data, "\e[2J");
+    $data = substr($data, 0, $pos) if $pos > 0;
+}
+
+my @screen = map { [ (' ') x $cols ] } 1 .. $rows;
+my ($r, $c) = (0, 0);
+my ($sr, $sc) = (0, 0);
+
+sub clamp { my ($v, $lo, $hi) = @_; $v < $lo ? $lo : $v > $hi ? $hi : $v }
+
+my $i = 0;
+my $len = length $data;
+while ($i < $len) {
+    my $ch = substr($data, $i, 1);
+    if ($ch eq "\e") {
+        my $next = substr($data, $i + 1, 1);
+        if ($next eq '[') {
+            if (substr($data, $i + 2) =~ /^([\?>!]?[0-9;]*)([\x40-\x7e])/) {
+                my ($params, $final) = ($1, $2);
+                $i += 2 + length($params) + 1;
+                my @p = split /;/, ($params =~ s/^[\?>!]//r);
+                if ($final eq 'H' or $final eq 'f') {
+                    $r = clamp((($p[0] // 1) || 1) - 1, 0, $rows - 1);
+                    $c = clamp((($p[1] // 1) || 1) - 1, 0, $cols - 1);
+                } elsif ($final eq 'A') { $r = clamp($r - (($p[0] // 1) || 1), 0, $rows - 1) }
+                elsif ($final eq 'B') { $r = clamp($r + (($p[0] // 1) || 1), 0, $rows - 1) }
+                elsif ($final eq 'C') { $c = clamp($c + (($p[0] // 1) || 1), 0, $cols - 1) }
+                elsif ($final eq 'D') { $c = clamp($c - (($p[0] // 1) || 1), 0, $cols - 1) }
+                elsif ($final eq 'G') { $c = clamp((($p[0] // 1) || 1) - 1, 0, $cols - 1) }
+                elsif ($final eq 'd') { $r = clamp((($p[0] // 1) || 1) - 1, 0, $rows - 1) }
+                elsif ($final eq 'J') {
+                    my $mode = $p[0] // 0;
+                    if ($mode == 2 or $mode == 3) { @screen = map { [ (' ') x $cols ] } 1 .. $rows }
+                    elsif ($mode == 0) { $screen[$r][$_] = ' ' for $c .. $cols - 1; $screen[$_] = [ (' ') x $cols ] for $r + 1 .. $rows - 1 }
+                    else { $screen[$r][$_] = ' ' for 0 .. $c; $screen[$_] = [ (' ') x $cols ] for 0 .. $r - 1 }
+                } elsif ($final eq 'K') {
+                    my $mode = $p[0] // 0;
+                    if ($mode == 0) { $screen[$r][$_] = ' ' for $c .. $cols - 1 }
+                    elsif ($mode == 1) { $screen[$r][$_] = ' ' for 0 .. $c }
+                    else { $screen[$r] = [ (' ') x $cols ] }
+                } elsif ($final eq 's') { ($sr, $sc) = ($r, $c) }
+                elsif ($final eq 'u') { ($r, $c) = ($sr, $sc) }
+                # SGR (m), private modes (h/l), others: ignored
+                next;
+            }
+            $i += 2; next;
+        } elsif ($next eq '7') { ($sr, $sc) = ($r, $c); $i += 2; next }
+        elsif ($next eq '8') { ($r, $c) = ($sr, $sc); $i += 2; next }
+        elsif ($next eq ']') {   # OSC ... BEL or ST
+            my $rest = substr($data, $i);
+            if ($rest =~ /^\e\].*?(\a|\e\\)/s) { $i += length($&); next }
+            $i += 2; next;
+        } elsif ($next eq '(' or $next eq ')') { $i += 3; next }
+        else { $i += 2; next }
+    } elsif ($ch eq "\r") { $c = 0; $i++; next }
+    elsif ($ch eq "\n") { $r = clamp($r + 1, 0, $rows - 1); $c = 0; $i++; next }
+    elsif ($ch eq "\b") { $c = clamp($c - 1, 0, $cols - 1); $i++; next }
+    elsif ($ch eq "\a" or $ch eq "\x0f" or $ch eq "\x0e") { $i++; next }
+    elsif (ord($ch) < 0x20) { $i++; next }
+    $screen[$r][$c] = $ch;
+    $c++;
+    if ($c >= $cols) { $c = $cols - 1 }
+    $i++;
+}
+
+for my $line (@screen) {
+    my $t = join '', @$line;
+    $t =~ s/\s+$//;
+    print "$t\n";
+}
diff --git a/tools/aix/check_imports.pl b/tools/aix/check_imports.pl
new file mode 100755
index 0000000..5fea5e4
--- /dev/null
+++ b/tools/aix/check_imports.pl
@@ -0,0 +1,44 @@
+#!/usr/bin/perl
+# check_imports.pl -- Projekt btop-aix (2026-10-12)
+# Zweck: Prueft, ob alle Symbole, die ein XCOFF-Binary (oder eine Liste von
+#        Importen) aus Systembibliotheken importiert, auf einem Zielsystem
+#        exportiert werden. Dient dem Nachweis "auf AIX 7.2 gebaut, laeuft auf 7.1".
+# Eingaben:
+#   --imports <datei>   Liste der Importe (ein Symbol je Zeile), erzeugt mit
+#                       dump -X64 -Tv <binary> | awk '$4=="IMP"{print $NF}' | sort -u
+#   --exports <datei>   Liste der Exporte des Zielsystems (ein Symbol je Zeile), erzeugt mit
+#                       dump -X64 -Tv /usr/lib/libc.a ... | awk '$4=="EXP"{print $NF}' | sort -u
+#   --ignore <regex>    Symbole, die nicht aus libc/libpthreads/libperfstat kommen
+#                       (z. B. ^_Z.*|^__cxa|^_Unwind) und daher nicht geprueft werden.
+# Ausgabe: fehlende Symbole (eines je Zeile) und eine Summenzeile; rc 0 = nichts fehlt.
+# Letzter bekannter guter Aufruf:
+#   perl tools/aix/check_imports.pl --imports <importliste>.txt \
+#        --exports <exportliste>.txt (z. B. tools/aix/analysis/libc_exports_*.txt) \
+#        --ignore '^(_Z|__cxa_|_Unwind_|__xlcxx|__dynamic_cast|__tls_get_mod)'
+use strict;
+use warnings;
+use Getopt::Long;
+
+my ($imports, $exports, $ignore) = ('', '', '');
+GetOptions('imports=s' => \$imports, 'exports=s' => \$exports, 'ignore=s' => \$ignore)
+    or die "Aufruf: $0 --imports DATEI --exports DATEI [--ignore REGEX]\n";
+die "--imports und --exports sind Pflicht\n" unless $imports && $exports;
+
+my %exp;
+open my $e, '<', $exports or die "$exports: $!";
+while (<$e>) { chomp; next unless length; $exp{(split)[-1]} = 1 }   # auch Zeilen "lib symbol" (letztes Feld zaehlt)
+close $e;
+
+my ($total, $skipped, @missing) = (0, 0);
+open my $i, '<', $imports or die "$imports: $!";
+while (<$i>) {
+    chomp; next unless length;
+    if ($ignore ne '' && /$ignore/) { $skipped++; next }
+    $total++;
+    push @missing, $_ unless $exp{$_};
+}
+close $i;
+
+print "$_\n" for @missing;
+printf "geprueft=%d ignoriert=%d fehlend=%d exporte=%d\n", $total, $skipped, scalar @missing, scalar keys %exp;
+exit(@missing ? 1 : 0);
diff --git a/tools/aix/probes/cxxrt_probe.cpp b/tools/aix/probes/cxxrt_probe.cpp
new file mode 100644
index 0000000..0ce14c6
--- /dev/null
+++ b/tools/aix/probes/cxxrt_probe.cpp
@@ -0,0 +1,46 @@
+// cxxrt_probe.cpp -- Projekt btop-aix (2026-10-12)
+// Zweck: Prueft, ob ein mit Open XL 17.1.3 (libc++ 19) auf AIX 7.2 gebautes
+// C++23-Programm auf AIX 7.1 laeuft, wenn die libc++-Laufzeit (libc++.a,
+// libc++abi.a, libunwind.a) ueber LIBPATH mitgegeben wird. Uebt die Teile,
+// die btop braucht: Threads, Exceptions, iostream, std::expected, ranges::to,
+// string::contains, optional-Monaden, chrono, filesystem, clock_gettime.
+// Bauen (AIX-7.2-Build-Host mit Open XL): /opt/IBM/openxlC/17.1.3/bin/ibm-clang++_r -m64 -std=c++23 -O1
+//                  -pthread -o cxxrt_probe cxxrt_probe.cpp
+#include <chrono>
+#include <ctime>
+#include <expected>
+#include <filesystem>
+#include <iostream>
+#include <optional>
+#include <ranges>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+#include <version>
+
+static std::expected<int, std::string> parse(const std::string& s) {
+	if (s.empty()) return std::unexpected("leer");
+	return std::stoi(s);
+}
+
+int main() {
+	std::cout << "_LIBCPP_VERSION=" << _LIBCPP_VERSION << " __cplusplus=" << __cplusplus << "\n";
+	auto v = std::views::iota(1, 6) | std::ranges::to<std::vector<int>>();
+	std::string s = "btop on aix";
+	std::optional<int> o = 20;
+	auto o2 = o.and_then([](int x) { return std::optional<int>{x * 2}; });
+	std::cout << "ranges::to size=" << v.size() << " contains=" << s.contains("aix") << " monad=" << o2.value_or(0) << "\n";
+	std::cout << "expected ok=" << parse("42").value() << " err=" << parse("").error() << "\n";
+	int sum = 0;
+	std::thread t([&] { for (int i : v) sum += i; });
+	t.join();
+	std::cout << "thread sum=" << sum << "\n";
+	try { throw std::runtime_error("exception ok"); } catch (const std::exception& e) { std::cout << e.what() << "\n"; }
+	timespec ts{};
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	std::cout << "monotonic=" << ts.tv_sec << " fs_exists(/etc)=" << std::filesystem::exists("/etc") << "\n";
+	std::cout << "steady=" << std::chrono::steady_clock::now().time_since_epoch().count() << "\n";
+	std::cout << "OK\n";
+	return 0;
+}
diff --git a/tools/aix/probes/libcall_probe.c b/tools/aix/probes/libcall_probe.c
new file mode 100644
index 0000000..43485aa
--- /dev/null
+++ b/tools/aix/probes/libcall_probe.c
@@ -0,0 +1,19 @@
+/* libcall_probe.c -- Projekt btop-aix (2026-10-12)
+ *
+ * Zweck: Zeigt, welche libc-Symbole IBM Open XL (LLVM 19) fuer strlen()/strcmp()
+ * in 64-Bit-Objekten referenziert. Auf AIX 7.1/7.2 heissen sie ___strlen64 und
+ * ___strcmp64; die libc von AIX 6.1 (6100-09) exportiert sie nicht (gemessen an
+ * den Importen des 7.1-btop gegen die 6.1-Exportliste). Die Sonde prueft, ob
+ * -fno-builtin-strlen -fno-builtin-strcmp die Umbenennung unterdrueckt.
+ *
+ * Bauen (AIX-7.2-Build-Host, Open XL, 64 Bit), Symbole mit nm:
+ *   /opt/IBM/openxlC/17.1.3/bin/ibm-clang_r -m64 -O2 -c -o libcall_probe.o libcall_probe.c
+ *   nm -X64 libcall_probe.o | grep -i 'str'
+ *   /opt/IBM/openxlC/17.1.3/bin/ibm-clang_r -m64 -O2 -fno-builtin-strlen -fno-builtin-strcmp -c -o libcall_probe_nb.o libcall_probe.c
+ *   nm -X64 libcall_probe_nb.o | grep -i 'str'
+ */
+#include <string.h>
+#include <stddef.h>
+
+size_t probe_len(const char *s) { return strlen(s); }
+int probe_cmp(const char *a, const char *b) { return strcmp(a, b); }
diff --git a/tools/aix/probes/perfstat_layout/layout.cpp b/tools/aix/probes/perfstat_layout/layout.cpp
new file mode 100644
index 0000000..7f20785
--- /dev/null
+++ b/tools/aix/probes/perfstat_layout/layout.cpp
@@ -0,0 +1,29 @@
+// layout.cpp -- project btop-aix (2026-10-12): host-side analysis, NOT an AIX build.
+// Prints sizeof and the offsets of the fields btop reads for one libperfstat header version
+// (SAP-wrapped copies under .../src/libperfstat/includes, namespace PERFSTAT_<ver> or global).
+// Build (Linux host, per version): clang++-22 -std=c++20 -m64 -x c++ -w -I tools/aix/probes/perfstat_layout -isystem tools/aix/probes/perfstat_layout/stub
+//        -DHDR='"<path>/libperfstat_<ver>.h"' [-DNS=PERFSTAT_<ver>] -o layout layout.cpp
+#include "preamble.h"
+typedef int cpu_t;
+#include HDR
+#include <cstdio>
+#include <cstddef>
+#ifdef NS
+using namespace NS;
+#endif
+#define OFF(T, f) []<class U>(U *) { if constexpr (requires(U u) { u.f; }) printf("  %-22s %-14s off=%4zu size=%zu\n", #T, #f, offsetof(U, f), sizeof(U::f)); else printf("  %-22s %-14s (not in this version)\n", #T, #f); }((T *)nullptr)
+int main() {
+	printf("sizeof: cpu_total=%zu cpu=%zu memory_total=%zu disk=%zu netinterface=%zu",
+	       sizeof(perfstat_cpu_total_t), sizeof(perfstat_cpu_t), sizeof(perfstat_memory_total_t), sizeof(perfstat_disk_t), sizeof(perfstat_netinterface_t));
+	if constexpr (requires { sizeof(perfstat_logicalvolume_t); }) printf(" logicalvolume=%zu\n", sizeof(perfstat_logicalvolume_t)); else printf(" logicalvolume=(none)\n");
+	OFF(perfstat_cpu_total_t, ncpus); OFF(perfstat_cpu_total_t, description); OFF(perfstat_cpu_total_t, processorHZ); OFF(perfstat_cpu_total_t, loadavg);
+	OFF(perfstat_cpu_total_t, user); OFF(perfstat_cpu_total_t, sys); OFF(perfstat_cpu_total_t, idle); OFF(perfstat_cpu_total_t, wait); OFF(perfstat_cpu_total_t, lbolt);
+	OFF(perfstat_cpu_t, name); OFF(perfstat_cpu_t, user); OFF(perfstat_cpu_t, sys); OFF(perfstat_cpu_t, idle); OFF(perfstat_cpu_t, wait);
+	OFF(perfstat_memory_total_t, real_total); OFF(perfstat_memory_total_t, real_free); OFF(perfstat_memory_total_t, real_inuse); OFF(perfstat_memory_total_t, numperm);
+	OFF(perfstat_memory_total_t, pgsp_total); OFF(perfstat_memory_total_t, pgsp_free); OFF(perfstat_memory_total_t, real_avail);
+	OFF(perfstat_disk_t, name); OFF(perfstat_disk_t, description); OFF(perfstat_disk_t, vgname); OFF(perfstat_disk_t, size); OFF(perfstat_disk_t, free); OFF(perfstat_disk_t, bsize);
+	OFF(perfstat_disk_t, xfers); OFF(perfstat_disk_t, wblks); OFF(perfstat_disk_t, rblks); OFF(perfstat_disk_t, qdepth); OFF(perfstat_disk_t, time);
+	OFF(perfstat_netinterface_t, name); OFF(perfstat_netinterface_t, ibytes); OFF(perfstat_netinterface_t, obytes);
+	if constexpr (requires { sizeof(perfstat_logicalvolume_t); }) { OFF(perfstat_logicalvolume_t, name); OFF(perfstat_logicalvolume_t, kbreads); OFF(perfstat_logicalvolume_t, kbwrites); }
+	return 0;
+}
