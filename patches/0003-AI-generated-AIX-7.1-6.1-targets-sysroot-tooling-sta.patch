diff --git a/tools/aix/sysroot71/aix61_compat.h b/tools/aix/sysroot71/aix61_compat.h
new file mode 100644
index 0000000..a63842f
--- /dev/null
+++ b/tools/aix/sysroot71/aix61_compat.h
@@ -0,0 +1,135 @@
+/* aix61_compat.h -- project btop-aix (2026-10-12)
+ *
+ * Who/what: Prepended via "-include" when building libc++/libc++abi/libunwind (LLVM 19.1.7)
+ * and btop against the AIX 6.1 sysroot. The AIX 6.1 libc
+ * (bos.rte.libc 6.1.9.30, measured 2026-10-12 on 6100-09-04) lacks the
+ * POSIX 2008 locale interface: no locale_t, no newlocale/uselocale/
+ * freelocale, no *_l functions (isdigit_l, strcoll_l, towupper_l, ...).
+ * libc++ 19 requires them on AIX (locale_base_api/ibm.h).
+ *
+ * Emulation here: one single, global locale. newlocale returns a
+ * placeholder (never NULL, otherwise locale_byname throws), uselocale/freelocale do
+ * nothing, every *_l function calls the variant without the locale argument. Consequence:
+ * std::locale("de_DE") creates no locale of its own; number and time formats follow
+ * the process locale set by setlocale(3). btop needs only the "C" locale.
+ *
+ * In addition, from aix71_compat.h: strftime_l (through the dummy uselocale here) and
+ * the noreturn declarations of abort/exit/_Exit.
+ * Also aligned_alloc through posix_memalign (missing before 6.1 TL9), so that the package loads from 6.1 TL7 on.
+ *
+ * Further 6.1 specifics live in the compiler flags (preset aix61-openxl,
+ * build_rt.pl --extra-flags): -fno-builtin-strlen -fno-builtin-strcmp, because
+ * Open XL otherwise references ___strlen64/___strcmp64, which 6.1 does not export
+ * (probe tools/aix/probes/libcall_probe.c), and -DREMOVE_ALL_USE_DIRECTORY_ITERATOR,
+ * because 6.1 lacks openat/fdopendir/unlinkat (libc++ provides the
+ * directory iterator path for that). fchmodat/utimensat drop out by themselves, because 6.1
+ * does not define AT_FDCWD and UTIME_OMIT.
+ *
+ * Include only for builds against the 6.1 sysroot (Open XL defines _AIX72
+ * according to the build host, not the sysroot - no macro guard possible).
+ */
+#ifndef BTOP_AIX61_COMPAT_H
+#define BTOP_AIX61_COMPAT_H
+
+#if defined(_AIX)
+
+#include <ctype.h>
+#include <locale.h>
+#include <stddef.h>
+#include <string.h>
+#include <wchar.h>
+#include <wctype.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* --- locale objects: one global locale -------------------------------------- */
+typedef struct __btop_locale *locale_t;
+
+#define LC_GLOBAL_LOCALE ((locale_t)-1)
+#define LC_COLLATE_MASK  (1 << LC_COLLATE)
+#define LC_CTYPE_MASK    (1 << LC_CTYPE)
+#define LC_MONETARY_MASK (1 << LC_MONETARY)
+#define LC_NUMERIC_MASK  (1 << LC_NUMERIC)
+#define LC_TIME_MASK     (1 << LC_TIME)
+#define LC_MESSAGES_MASK (1 << LC_MESSAGES)
+#define LC_ALL_MASK      (LC_COLLATE_MASK | LC_CTYPE_MASK | LC_MONETARY_MASK | \
+                          LC_NUMERIC_MASK | LC_TIME_MASK | LC_MESSAGES_MASK)
+
+static inline locale_t newlocale(int __mask, const char *__name, locale_t __base)
+{
+	static struct { int unused; } __btop_the_locale;
+	(void)__mask; (void)__name; (void)__base;
+	return (locale_t)&__btop_the_locale;
+}
+static inline locale_t duplocale(locale_t __loc) { return __loc; }
+static inline void     freelocale(locale_t __loc) { (void)__loc; }
+static inline locale_t uselocale(locale_t __loc) { (void)__loc; return LC_GLOBAL_LOCALE; }
+
+#ifdef __cplusplus
+}
+#endif
+
+/* strftime_l and noreturn declarations (uses the uselocale above) */
+#include "aix71_compat.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* --- *_l functions: the locale argument is ignored ------------------------- */
+#define BTOP_CTYPE_L(name) \
+	static inline int name##_l(int __c, locale_t __l) { (void)__l; return name(__c); }
+BTOP_CTYPE_L(isalnum) BTOP_CTYPE_L(isalpha) BTOP_CTYPE_L(isblank) BTOP_CTYPE_L(iscntrl)
+BTOP_CTYPE_L(isdigit) BTOP_CTYPE_L(isgraph) BTOP_CTYPE_L(islower) BTOP_CTYPE_L(isprint)
+BTOP_CTYPE_L(ispunct) BTOP_CTYPE_L(isspace) BTOP_CTYPE_L(isupper) BTOP_CTYPE_L(isxdigit)
+BTOP_CTYPE_L(tolower) BTOP_CTYPE_L(toupper)
+#undef BTOP_CTYPE_L
+
+#define BTOP_WCTYPE_L(name) \
+	static inline int name##_l(wint_t __c, locale_t __l) { (void)__l; return name(__c); }
+BTOP_WCTYPE_L(iswalnum) BTOP_WCTYPE_L(iswalpha) BTOP_WCTYPE_L(iswblank) BTOP_WCTYPE_L(iswcntrl)
+BTOP_WCTYPE_L(iswdigit) BTOP_WCTYPE_L(iswgraph) BTOP_WCTYPE_L(iswlower) BTOP_WCTYPE_L(iswprint)
+BTOP_WCTYPE_L(iswpunct) BTOP_WCTYPE_L(iswspace) BTOP_WCTYPE_L(iswupper) BTOP_WCTYPE_L(iswxdigit)
+#undef BTOP_WCTYPE_L
+
+static inline wint_t towlower_l(wint_t __c, locale_t __l) { (void)__l; return towlower(__c); }
+static inline wint_t towupper_l(wint_t __c, locale_t __l) { (void)__l; return towupper(__c); }
+static inline int    iswctype_l(wint_t __c, wctype_t __t, locale_t __l) { (void)__l; return iswctype(__c, __t); }
+static inline wctype_t wctype_l(const char *__p, locale_t __l) { (void)__l; return wctype(__p); }
+
+static inline int    strcoll_l(const char *__a, const char *__b, locale_t __l) { (void)__l; return strcoll(__a, __b); }
+static inline size_t strxfrm_l(char *__d, const char *__s, size_t __n, locale_t __l) { (void)__l; return strxfrm(__d, __s, __n); }
+static inline int    wcscoll_l(const wchar_t *__a, const wchar_t *__b, locale_t __l) { (void)__l; return wcscoll(__a, __b); }
+static inline size_t wcsxfrm_l(wchar_t *__d, const wchar_t *__s, size_t __n, locale_t __l) { (void)__l; return wcsxfrm(__d, __s, __n); }
+
+#ifdef __cplusplus
+}
+#endif
+
+/* --- aligned_alloc (C11) ------------------------------------------------------ */
+/* Missing in the libc before 6.1 TL9 (measured 2026-10-12 on 6100-07-10: the loader aborts with
+ * "Symbol aligned_alloc ... not exported"). libc++ 19 calls it for over-aligned
+ * operator new (__libcpp_aligned_alloc). Replaced through posix_memalign, which 6.1 has since TL0;
+ * free(3) matches both. The macro affects libc++, libc++abi and btop (all via -include). */
+#include <stdlib.h>
+#include <errno.h>
+static inline void *btop_aligned_alloc(size_t alignment, size_t size) {
+	void *p = NULL;
+	const int rc = posix_memalign(&p, alignment < sizeof(void *) ? sizeof(void *) : alignment, size);
+	if (rc != 0) { errno = rc; return NULL; }
+	return p;
+}
+#define aligned_alloc btop_aligned_alloc
+
+/* --- open(2) flag ----------------------------------------------------------- */
+/* 6.1 has no O_CLOEXEC (7.1 and later). btop uses it only to open files for reading and starts
+ * no child processes, so a neutral flag suffices. */
+#include <fcntl.h>
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+
+#endif /* _AIX */
+#endif /* BTOP_AIX61_COMPAT_H */
diff --git a/tools/aix/sysroot71/aix71_compat.h b/tools/aix/sysroot71/aix71_compat.h
new file mode 100644
index 0000000..464afc3
--- /dev/null
+++ b/tools/aix/sysroot71/aix71_compat.h
@@ -0,0 +1,50 @@
+/* aix71_compat.h -- project btop-aix (2026-10-12)
+ *
+ * Who/what: Prepended via "-include" when building libc++/libc++abi/libunwind (LLVM 19.1.7)
+ * and btop against the AIX 7.1 sysroot. AIX 7.1 (bos.rte
+ * 7.1.5.31) has no strftime_l(3); libc++ calls it in src/locale.cpp.
+ * The function is emulated here as static inline through uselocale(3)+strftime(3),
+ * so that no import from libc arises (measured 2026-10-12:
+ * strftime_l is the only symbol of the libc++ 19 runtime that 7.1 lacks).
+ *
+ * Include only for builds against the 7.1 sysroot: Open XL defines _AIX72
+ * according to the build host, not the sysroot, hence no macro guard.
+ * On AIX 7.2 and later, <time.h> declares strftime_l itself.
+ */
+#ifndef BTOP_AIX71_COMPAT_H
+#define BTOP_AIX71_COMPAT_H
+
+#if defined(_AIX)
+
+#include <locale.h>
+#include <stdlib.h>
+#include <time.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The 7.1 <stdlib.h> declares abort/exit/_Exit without noreturn; libunwind and
+ * libc++ build with -Werror=return-type and need the guarantee.
+ * Repeating the declaration with a GNU attribute is permitted. */
+extern void abort(void) __attribute__((__noreturn__));
+extern void exit(int) __attribute__((__noreturn__));
+extern void _Exit(int) __attribute__((__noreturn__));
+
+static inline size_t strftime_l(char *__buf, size_t __max, const char *__fmt,
+                                const struct tm *__tm, locale_t __loc)
+{
+	locale_t __old = uselocale(__loc);
+	size_t __n = strftime(__buf, __max, __fmt, __tm);
+	if (__old != (locale_t)0)
+		uselocale(__old);
+	return __n;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _AIX */
+#endif /* BTOP_AIX71_COMPAT_H */
diff --git a/tools/aix/sysroot71/build_rt.pl b/tools/aix/sysroot71/build_rt.pl
new file mode 100755
index 0000000..fb70127
--- /dev/null
+++ b/tools/aix/sysroot71/build_rt.pl
@@ -0,0 +1,76 @@
+#!/usr/bin/perl
+# build_rt.pl -- project btop-aix (2026-10-12)
+#
+# Who/what: Builds libunwind, libc++abi and libc++ from the LLVM 19.1.7 sources with
+#           IBM Open XL 17.1.3 on an AIX 7.2 host AGAINST AN OLDER AIX SYSROOT (7.1 or 6.1), statically,
+#           and installs them into <prefix>. This lets btop be linked for AIX 7.1
+#           (the IBM runtime 17.1.3 does not run on 7.1: PTHREAD_MUTEX_INITIALIZER
+#           has a different layout there, strftime_l is missing).
+#
+# Runs on the AIX build host (AIX 7.2 build host with Open XL). Usage:
+#   perl build_rt.pl --src /build/btop-aix/llvm-project-19.1.7.src \
+#        --sysroot /build/btop-aix/sysroot71 --prefix /build/btop-aix/rt71 \
+#        --build /build/btop-aix/build-rt71 --compat /build/btop-aix/aix71_compat.h [--jobs 12] [--configure-only]
+#        [--extra-flags "-fno-builtin-strlen -fno-builtin-strcmp -DREMOVE_ALL_USE_DIRECTORY_ITERATOR"]  (AIX 6.1, see aix61_compat.h)
+# Compiler: IBM Open XL only, absolute path (rule aix.md).
+use strict;
+use warnings;
+use Getopt::Long;
+use File::Path qw(make_path);
+
+my %o = (jobs => 12, 'extra-flags' => '');
+GetOptions(\%o, 'src=s', 'sysroot=s', 'prefix=s', 'build=s', 'compat=s', 'jobs=i', 'configure-only', 'extra-flags=s')
+    or die "usage: $0 --src DIR --sysroot DIR --prefix DIR --build DIR --compat FILE [--jobs N] [--configure-only] [--extra-flags FLAGS]\n";
+for (qw(src sysroot prefix build compat)) { die "--$_ missing\n" unless $o{$_} }
+for (qw(src sysroot compat)) { die "$o{$_}: not found\n" unless -e $o{$_} }
+
+$ENV{OBJECT_MODE} = '64';
+$ENV{PATH} = "/opt/freeware/bin:$ENV{PATH}";
+my $cc  = '/opt/IBM/openxlC/17.1.3/bin/ibm-clang_r';
+my $cxx = '/opt/IBM/openxlC/17.1.3/bin/ibm-clang++_r';
+die "$cc missing\n" unless -x $cc;
+
+my $flags = "-m64 --sysroot=$o{sysroot} -include $o{compat} -D__LIBC_NO_CPP_MATH_OVERLOADS__ $o{'extra-flags'}";
+# C++: wrapper headers with extern "C" around the 7.1 C headers (make_cxxwrap.pl)
+my $cxxflags = "$flags -isystem $o{sysroot}/cxxwrap";
+die "$o{sysroot}/cxxwrap missing - run make_cxxwrap.pl first\n" unless -d "$o{sysroot}/cxxwrap";
+# Libraries from the sysroot first (the driver passes no -L for the sysroot).
+my $ldflags = "-L$o{sysroot}/usr/lib";
+
+make_path($o{build});
+chdir $o{build} or die "chdir $o{build}: $!";
+
+my @cmake = (
+    'cmake', '-G', 'Ninja', "$o{src}/runtimes",
+    '-C', "$o{src}/libcxx/cmake/caches/AIX.cmake",
+    "-DCMAKE_C_COMPILER=$cc", "-DCMAKE_CXX_COMPILER=$cxx",
+    "-DCMAKE_C_FLAGS=$flags", "-DCMAKE_CXX_FLAGS=$cxxflags",
+    "-DCMAKE_EXE_LINKER_FLAGS=$ldflags", "-DCMAKE_SHARED_LINKER_FLAGS=$ldflags -Wl,-G -Wl,-bcdtors:all:-2147483548:s",
+    "-DCMAKE_INSTALL_PREFIX=$o{prefix}",
+    '-DCMAKE_BUILD_TYPE=Release',
+    '-DLLVM_ENABLE_RUNTIMES=libunwind;libcxxabi;libcxx',
+    '-DLIBCXX_ENABLE_SHARED=OFF', '-DLIBCXX_ENABLE_STATIC=ON',
+    '-DLIBCXXABI_ENABLE_SHARED=OFF', '-DLIBCXXABI_ENABLE_STATIC=ON',
+    '-DLIBUNWIND_ENABLE_SHARED=OFF', '-DLIBUNWIND_ENABLE_STATIC=ON',
+    '-DLIBCXX_INCLUDE_TESTS=OFF', '-DLIBCXX_INCLUDE_BENCHMARKS=OFF',
+    '-DLIBCXXABI_INCLUDE_TESTS=OFF', '-DLIBUNWIND_INCLUDE_TESTS=OFF',
+    '-DLIBCXX_CXX_ABI=libcxxabi', '-DLIBCXXABI_USE_LLVM_UNWINDER=ON',
+    '-DLIBCXX_USE_COMPILER_RT=ON', '-DLIBCXXABI_USE_COMPILER_RT=ON', '-DLIBUNWIND_USE_COMPILER_RT=ON',
+    '-DLIBCXX_ENABLE_STATIC_ABI_LIBRARY=ON',
+    '-DLIBCXX_HARDENING_MODE=none',
+    # __cxa_thread_atexit_impl exists only from the 7.2 libc on; the CMake test finds it through
+    # the host libraries and would produce a binary that does not load on 7.1.
+    '-DLIBCXXABI_HAS_CXA_THREAD_ATEXIT_IMPL=OFF',
+);
+print "+ @cmake\n";
+system(@cmake) == 0 or die "cmake configure rc=" . ($? >> 8) . "\n";
+exit 0 if $o{'configure-only'};
+
+my @build = ('ninja', '-j', $o{jobs}, 'cxx', 'cxxabi', 'unwind');
+print "+ @build\n";
+system(@build) == 0 or die "ninja rc=" . ($? >> 8) . "\n";
+
+my @install = ('ninja', 'install-cxx', 'install-cxxabi', 'install-unwind');
+print "+ @install\n";
+system(@install) == 0 or die "ninja install rc=" . ($? >> 8) . "\n";
+print "DONE: $o{prefix}\n";
