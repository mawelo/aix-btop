+if(NOT APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "AIX")
+  # IBM Open XL on AIX accepts the flag but ignores it with a warning on every file
   target_compile_options(libbtop PUBLIC -fstack-clash-protection)
